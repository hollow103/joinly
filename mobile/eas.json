{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "ios": { "simulator": true }
    },
    "preview": {
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "ios": { "simulator": false },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://REEMPLAZAR-cuando-se-elija-host.example.com/api/v1",
        "EXPO_PUBLIC_SUPABASE_URL": "https://REEMPLAZAR.supabase.co",
        "EXPO_PUBLIC_SUPABASE_ANON_KEY": "REEMPLAZAR-anon-key-del-mismo-proyecto"
      }
    },
    "production": {
      "distribution": "internal",
      "android": { "buildType": "app-bundle" },
      "ios": { "simulator": false },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://REEMPLAZAR-cuando-se-elija-host.example.com/api/v1",
        "EXPO_PUBLIC_SUPABASE_URL": "https://REEMPLAZAR.supabase.co",
        "EXPO_PUBLIC_SUPABASE_ANON_KEY": "REEMPLAZAR-anon-key-del-mismo-proyecto"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
