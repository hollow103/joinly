# Copia este archivo a admin/.env y ajusta los valores.
# Las variables VITE_* se inyectan en el bundle al compilar.

# URL base de la API. En desarrollo usa la ruta relativa /api/v1: Vite hace
# proxy al backend (vite.config.ts) y así no hace falta CORS en el backend.
# En una build desplegada, pon la URL absoluta: https://<host>/api/v1
VITE_API_BASE_URL=/api/v1

# Proyecto Supabase: DEBE ser el mismo que valida el backend (SUPABASE_ISSUER).
# El panel solo usa Supabase para el login; los datos vienen de la API.
VITE_SUPABASE_URL=https://ulxrjlmpzaeouqbjbnjc.supabase.co
VITE_SUPABASE_ANON_KEY=
