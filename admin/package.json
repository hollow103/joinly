{
  "name": "joinly-admin",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Panel interno de moderación de Joinly. Consume solo la API del backend; Supabase se usa únicamente para el login.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
